# ---------------------------------------------------------------------------
# Bu dosya ÖRNEKTİR ve depoya girer. Gerçek anahtarlar .env dosyasına yazılır;
# .env .gitignore'da, asla paylaşılmaz.
# ---------------------------------------------------------------------------

# DB_URL boş bırakılırsa data/finans_agent.db (SQLite) kullanılır.
# Postgres'e geçiş: DB_URL=postgresql+psycopg://user:pass@host:5432/finans_agent
DB_URL=

# --- LLM fallback (tasarım §06) --------------------------------------------
# YALNIZCA bir toplayıcının parse() adımı kırıldığında devreye girer.
# Normal akışta tek token harcanmaz.
#
# Varsayılan: Google Gemini'nin OpenAI-uyumlu uç noktası.
# Anahtar: https://aistudio.google.com/apikey (AIzaSy... ile başlar)
# Buradaki anahtar YALNIZCA planlı koşuları besler. Panelin "Şimdi tazele"
# düğmesi onu harcayamaz: o düğme kullanıcının kendi girdiği anahtarla
# çalışır (bkz. app/panels/agent.py). Panel dışarı açıksa fatura açığı
# olmaması için bu ayrım kasıtlı.
LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
LLM_MODEL=gemini-3.5-flash-lite
LLM_API_KEY=

# Fallback GÜVENLİK ANAHTARI: anahtar dolu olsa bile bu 1 yapılmadıkça
# hiçbir LLM çağrısı yapılmaz. Kazara token yakmaya karşı.
LLM_FALLBACK_ENABLED=0

# Token korumaları (hepsi isteğe bağlı; varsayılanlar bilinçli olarak düşük)
LLM_MAX_INPUT_CHARS=8000      # modele giden HTML'in üst sınırı
LLM_MAX_OUTPUT_TOKENS=2000    # yanıt üst sınırı
LLM_MAX_CALLS_PER_RUN=1       # worker koşusu başına en fazla çağrı
LLM_TIMEOUT_SECONDS=45        # asılı kalan çağrıyı kes

# Agent toplayıcısı (collectors/loan_rates_llm.py) banka BAŞINA bir çağrı
# yapar. Varsayılan 8'dir ve envanterdeki aktif sayfa sayısından azdır:
# olduğu gibi bırakılırsa ilk sekiz banka çekilir, gerisi SESSİZCE eksik
# kalır. Kaynak sayısı kadar (ya da üstünde) bir değer verin.
LLM_AGENT_MAX_CALLS_PER_RUN=60

# SAĞLAYICIYA ÖZEL EK GÖVDE ALANLARI (JSON nesnesi, OpenAI şemasında olmayan
# parametreler için).
#
# QWEN KULLANIYORSANIZ BU SATIR ZORUNLU. Qwen'in OpenAI-uyumlu ucunda
# DÜŞÜNME MODU VARSAYILAN OLARAK AÇIKTIR ve çıkarım işinde saf israftır.
# 2026-09-02'de ölçüldü, aynı istek:
#     düşünme açık : 1445 çıktı tokeni (1376'sı akıl yürütme)
#     düşünme kapalı:  41 çıktı tokeni
# Ayrıca akıl yürütme tokenleri max_tokens bütçesinden yediği için model
# JSON'u yazmaya sıra gelmeden kesilebilir; çağrı hem para yakar hem başarısız
# olur. Gemini/DeepSeek'e dönerseniz bu satırı boşaltın.
# Yukarıdaki VARSAYILAN Gemini olduğu için bu satır KAPALI gelir. Qwen'e
# geçerken başındaki # işaretini kaldırın:
#LLM_EXTRA_BODY={"enable_thinking": false}

# Tahmini maliyet için birim fiyat (USD / 1.000.000 token). BOŞ bırakılırsa
# maliyet "bilinmiyor" olarak gösterilir — 0 yazmak "bedava" demek olurdu.
# AI Studio ücretsiz katmanında gerçekten 0'dır; ücretli katmana geçince
# sağlayıcının fiyat sayfasından girilir.
LLM_PRICE_INPUT_PER_1M=
LLM_PRICE_OUTPUT_PER_1M=

# Başka sağlayıcı kullanmak istersen KOD DEĞİŞMEZ, sadece bu üçü değişir:
#   DeepSeek : LLM_BASE_URL=https://api.deepseek.com/v1            LLM_MODEL=deepseek-chat
#   Qwen     : LLM_BASE_URL=https://dashscope-intl.aliyuncs.com/compatible-mode/v1
#              LLM_MODEL=qwen-flash
#              (Qwen'de LLM_EXTRA_BODY'yi mutlaka doldurun — yukarı bkz.)
#   Yerel    : LLM_BASE_URL=http://localhost:11434/v1              LLM_MODEL=qwen3:8b

# --- Log ---------------------------------------------------------------------
# Konsola her zaman yazılır. LOG_DIR ayrıca DÖNEN dosya log'u açar
# (5 x 2 MB). Boş bırakılırsa dosyaya yazılmaz.
LOG_DIR=data/logs
LOG_LEVEL=INFO

# Zamanlayıcı: kaç dakikada bir tazelik telafisi yapılsın
CATCHUP_INTERVAL_MINUTES=30
# Süreç başlarken bir kez hepsini çeksin mi (yeni kurulumda panel boş gelmesin)
RUN_ON_START=1

# --- Kayıt saklama süreleri (gün) -------------------------------------------
# 0 = sınırsız sakla. http_requests koşu başına onlarca satır yazar; sunucuda
# kimse elle temizleyemeyeceği için budama zamanlayıcının işidir
# (bkz. store/retention.py). llm_calls ve rate_changes ASLA budanmaz:
# token/maliyet muhasebesi ve "oran en son ne zaman değişti" izi kümülatiftir.
RETAIN_HTTP_REQUEST_DAYS=30
RETAIN_SOURCE_RUN_DAYS=180
RETAIN_SCRAPE_RUN_DAYS=180
RETAIN_SNAPSHOT_DAYS=14

# --- Yedekleme --------------------------------------------------------------
# Zamanlayıcı günde bir kez, BUDAMADAN ÖNCE, SQLite'ın kendi çevrimiçi
# yedekleme API'siyle tutarlı bir kopya alır, `PRAGMA integrity_check` ile
# doğrular ve eskileri budar (bkz. store/backup.py).
#
# VARSAYILAN HEDEF AYNI VOLUME'DA. Bu; bozulmaya, hatalı bir göçe ve
# yanlışlıkla silmeye karşı korur — ama SD kart / SSD ölürse yedek de gider.
# GERÇEK cihaz dışı koruma istiyorsan BACKUP_DIR'i konteynere bağladığın
# başka bir diske yönlendir, örneğin docker-compose.yml'de:
#     volumes:
#       - /mnt/yedek/finans:/backups
# ve burada:
#     BACKUP_DIR=/backups
BACKUP_DIR=
BACKUP_KEEP_DAYS=14

# --- EVDS -------------------------------------------------------------------
# TCMB'nin resmi, ücretsiz API'si. Sektör ortalaması faiz oranı çapası için
# (bkz. §02). https://evds2.tcmb.gov.tr/index.php?/evds/login
EVDS_API_KEY=

# --- Panel -------------------------------------------------------------------
# ARTIK OKUNMUYOR (2026-09-06). Panelden `.env`'e yazma yolu kaldırıldı:
# bu dosya `.dockerignore`'da olduğu için imaja hiç girmiyor, panel ile
# zamanlayıcı ayrı konteynerler ve panelin yazacağı dosyayı zamanlayıcı
# göremiyordu; üstelik `docker compose up --build` onu her yeniden kurulumda
# siliyordu. Kalıcı anahtar artık VERİTABANINA yazılıyor (Agent sekmesi ->
# "Sürekli kullanmak için kaydet"), yani iki konteyner de görüyor ve yeniden
# kurulumda kaybolmuyor.
#PANEL_ALLOW_ENV_WRITE=0

# --- Çalıştırma: rol, adres, port (run.py / Docker) -------------------------
# ROLE tek konteynerde neyin kalkacağını belirler. run.py'nin varsayılanı
# "all"dır: panel VE zamanlayıcı birlikte. compose kurulumunda panel servisi
# ROLE=panel ile çalışır, çünkü zamanlayıcı ayrı bir servistir.
#   all (varsayılan) · panel · scheduler
ROLE=all

# DİKKAT — PANEL_ADDRESS varsayılanı 0.0.0.0'dır, yani panel makinenin TÜM
# arayüzlerinden erişilebilir. Panelde oturum yönetimi YOK; ağa açık bir
# makinede çalıştırıyorsan ya bunu 127.0.0.1 yap ya da önüne kimlik
# doğrulamalı bir reverse proxy koy. docker compose kurulumu portu zaten
# "127.0.0.1:8501:8501" ile bağlar, orada 0.0.0.0 konteynerin içinde kalır.
PANEL_ADDRESS=0.0.0.0
PANEL_PORT=8501

# ROLE=all iken run.py zamanlayıcı çocuğunu gözetler; ölmüşse kaç saniyede
# bir yeniden denesin. store/heartbeat.py'deki bayatlama süresinden uzun
# olmalı, yoksa ölü kilidin süresi henüz dolmamış olur.
SUPERVISE_INTERVAL_SECONDS=60

# --- Dosya yolları ----------------------------------------------------------
# Fon tanımları normalde config/funds.yaml'dan okunur. DATA_DIR verilirse
# önce <DATA_DIR>/funds.yaml aranır — konteynerde imajı yeniden kurmadan fon
# listesi değiştirilebilsin diye. FUNDS_YAML_PATH ikisini de atlar, dosyayı
# doğrudan gösterir. İkisi de boş bırakılabilir.
DATA_DIR=
FUNDS_YAML_PATH=
