# ---------------------------------------------------------------------------
# Bu dosya ÖRNEKTİR ve depoya girer. Gerçek anahtarlar .env dosyasına yazılır;
# .env .gitignore'da, asla paylaşılmaz.
# ---------------------------------------------------------------------------

# DB_URL boş bırakılırsa data/finans_agent.db (SQLite) kullanılır.
# Postgres'e geçiş: DB_URL=postgresql+psycopg://user:pass@host:5432/finans_agent
DB_URL=

# --- LLM fallback (tasarım §06) --------------------------------------------
# YALNIZCA bir toplayıcının parse() adımı kırıldığında devreye girer.
# Normal akışta tek token harcanmaz.
#
# Varsayılan: Google Gemini'nin OpenAI-uyumlu uç noktası.
# Anahtar: https://aistudio.google.com/apikey (AIzaSy... ile başlar)
# Bu dosyayı elle düzenlemek zorunda değilsin: panelin **Agent** sekmesi
# anahtarı buraya yazabiliyor ve zamanlayıcı .env'i her turda yeniden
# okuduğu için yeniden başlatma gerekmiyor.
LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
LLM_MODEL=gemini-3.5-flash-lite
LLM_API_KEY=

# Fallback GÜVENLİK ANAHTARI: anahtar dolu olsa bile bu 1 yapılmadıkça
# hiçbir LLM çağrısı yapılmaz. Kazara token yakmaya karşı.
LLM_FALLBACK_ENABLED=0

# Token korumaları (hepsi isteğe bağlı; varsayılanlar bilinçli olarak düşük)
LLM_MAX_INPUT_CHARS=8000      # modele giden HTML'in üst sınırı
LLM_MAX_OUTPUT_TOKENS=2000    # yanıt üst sınırı
LLM_MAX_CALLS_PER_RUN=1       # worker koşusu başına en fazla çağrı
LLM_TIMEOUT_SECONDS=45        # asılı kalan çağrıyı kes

# Tahmini maliyet için birim fiyat (USD / 1.000.000 token). BOŞ bırakılırsa
# maliyet "bilinmiyor" olarak gösterilir — 0 yazmak "bedava" demek olurdu.
# AI Studio ücretsiz katmanında gerçekten 0'dır; ücretli katmana geçince
# sağlayıcının fiyat sayfasından girilir.
LLM_PRICE_INPUT_PER_1M=
LLM_PRICE_OUTPUT_PER_1M=

# Başka sağlayıcı kullanmak istersen KOD DEĞİŞMEZ, sadece bu üçü değişir:
#   DeepSeek : LLM_BASE_URL=https://api.deepseek.com/v1            LLM_MODEL=deepseek-chat
#   Qwen     : LLM_BASE_URL=https://dashscope-intl.aliyuncs.com/compatible-mode/v1
#              LLM_MODEL=qwen-flash
#   Yerel    : LLM_BASE_URL=http://localhost:11434/v1              LLM_MODEL=qwen3:8b

# --- Log ---------------------------------------------------------------------
# Konsola her zaman yazılır. LOG_DIR ayrıca DÖNEN dosya log'u açar
# (5 x 2 MB). Boş bırakılırsa dosyaya yazılmaz.
LOG_DIR=data/logs
LOG_LEVEL=INFO

# Zamanlayıcı: kaç dakikada bir tazelik telafisi yapılsın
CATCHUP_INTERVAL_MINUTES=30
# Süreç başlarken bir kez hepsini çeksin mi (yeni kurulumda panel boş gelmesin)
RUN_ON_START=1

# --- Kayıt saklama süreleri (gün) -------------------------------------------
# 0 = sınırsız sakla. http_requests koşu başına onlarca satır yazar; sunucuda
# kimse elle temizleyemeyeceği için budama zamanlayıcının işidir
# (bkz. store/retention.py). llm_calls ve rate_changes ASLA budanmaz:
# token/maliyet muhasebesi ve "oran en son ne zaman değişti" izi kümülatiftir.
RETAIN_HTTP_REQUEST_DAYS=30
RETAIN_SOURCE_RUN_DAYS=180
RETAIN_SCRAPE_RUN_DAYS=180
RETAIN_SNAPSHOT_DAYS=14

# --- EVDS -------------------------------------------------------------------
# TCMB'nin resmi, ücretsiz API'si. Sektör ortalaması faiz oranı çapası için
# (bkz. §02). https://evds2.tcmb.gov.tr/index.php?/evds/login
EVDS_API_KEY=
